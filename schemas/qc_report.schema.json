            "hard",
            "soft"
          ],
          "title": "Severity",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "measured": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured"
        },
        "limit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        }
      },
      "required": [
        "name",
        "severity",
        "passed"
      ],
      "title": "QCCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
